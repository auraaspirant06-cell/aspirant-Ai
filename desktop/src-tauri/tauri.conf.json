{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aspirant AI NOVA",
  "version": "2.0.0",
  "identifier": "ai.aspirant.nova",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../electron/renderer.html"
  },
  "app": {
    "windows": [
      {
        "title": "Aspirant AI — NOVA Desktop",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "../assets/app-icon-512.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "../assets/app-icon-512.png",
      "../assets/app-icon.ico"
    ]
  }
}
