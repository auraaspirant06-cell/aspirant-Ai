# ASPIRANT AI Environment Template
# Copy to .env and configure only the keys you use. Never commit .env!

# --- Core Server & Security ---
ASPIRANT_HOST=127.0.0.1
ASPIRANT_PORT=8420
ASPIRANT_DATA_DIR=./data
ASPIRANT_RESTRICTED_MODE=false

# --- AI Text / Multimodal Providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Voice & Speech ---
ASPIRANT_WAKE_WORD=hey_aspirant
ASPIRANT_VOICE_DEFAULT_TTS=auto
ASPIRANT_VOICE_FEMALE_EN=en-IN-NeerjaNeural
ASPIRANT_VOICE_FEMALE_HI=hi-IN-SwaraNeural
ASPIRANT_STT_PROVIDER=auto
ASPIRANT_WHISPER_MODEL=tiny

# --- Media Providers ---
ASPIRANT_IMAGE_PROVIDER=gemini
ASPIRANT_VIDEO_PROVIDER=gemini-omni
ELEVENLABS_API_KEY=
