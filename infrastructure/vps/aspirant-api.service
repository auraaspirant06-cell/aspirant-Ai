[Unit]
Description=Aspirant AI Ecosystem FastAPI Server
After=network.target postgresql.service redis.service

[Service]
User=aspirant
Group=aspirant
WorkingDirectory=/opt/aspirant-ai
Environment="PYTHONPATH=/opt/aspirant-ai"
EnvironmentFile=/opt/aspirant-ai/.env
ExecStart=/opt/aspirant-ai/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
